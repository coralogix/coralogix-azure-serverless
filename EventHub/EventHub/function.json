{
  "bindings": [
    {
      "name": "events",
      "type": "eventHubTrigger",
      "direction": "in",
      "cardinality": "many",
      "eventHubName": "%EVENTHUB_INSTANCE_NAME%",
      "connection": "EVENTHUB_CONNECT_STRING",
      "consumerGroup": "%EVENTHUB_CONSUMER_GROUP%"
    }
  ],
  "scriptFile": "../dist/EventHub/index.js",
  "entryPoint": "eventHubTrigger",
  "disabled": false,
  "retry": {
    "strategy": "exponentialBackoff",
    "maxRetryCount": -1,
    "minimumInterval": "00:00:05",
    "maximumInterval": "00:05:00"
  }
}
